APP_NAME=Border Sentinel
APP_ENV=development
DATABASE_MODE=supabase
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# From Supabase dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key
AI_SERVICE_KEY=replace-with-a-long-random-ai-service-secret

# From Supabase dashboard -> Project Settings -> API -> JWT Keys
# (only needed if your project uses the newer asymmetric signing keys —
#  see backend/README section on auth for how to check)
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Backend-to-AI URL (the AI process is normally run separately).
AI_SERVICE_URL=http://localhost:8001
