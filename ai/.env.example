BACKEND_URL=http://localhost:8000
# MUST exactly match backend/.env AI_SERVICE_KEY. Do not use the
# Supabase service-role key here.
SERVICE_KEY=replace-with-the-same-AI_SERVICE_KEY-from-backend/.env

CAMERA_SOURCE=0
CONFIDENCE_THRESHOLD=0.5
# Optional — JSON polygon for the intrusion zone, e.g.:
FENCE_ZONE=[[100,100],[400,100],[400,400],[100,400]]

# Expected direction of travel for this camera. Objects that keep moving the
# opposite way are flagged as "counter-flow movement".
# One of: right (default) | left | up | down | none (disable the check)
FLOW_DIRECTION=right

# Face recognition (needs: python -m ai.face.download_face_models)
# FACE_RECOGNITION=off            # switch recognition off (Haar detection only)
# FACE_MATCH_THRESHOLD=0.363      # higher = stricter matching, fewer false matches
# FACE_MIN_IDENTIFY_PX=48         # smaller faces are labelled but not identified
