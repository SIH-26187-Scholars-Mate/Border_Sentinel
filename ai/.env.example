BACKEND_URL=http://localhost:8000
# MUST exactly match backend/.env AI_SERVICE_KEY. Do not use the
# Supabase service-role key here.
SERVICE_KEY=replace-with-the-same-AI_SERVICE_KEY-from-backend/.env

CAMERA_SOURCE=0
CONFIDENCE_THRESHOLD=0.5
# Optional — JSON polygon for the intrusion zone, e.g.:
FENCE_ZONE=[[100,100],[400,100],[400,400],[100,400]]
