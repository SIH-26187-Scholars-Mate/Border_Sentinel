# Frontend -> FastAPI backend
VITE_BACKEND_URL=http://localhost:8000

# Supabase project (Project Settings -> API). Same project as the backend's
# SUPABASE_URL / SUPABASE_ANON_KEY. Used directly by the browser for account
# creation (Register) and "Continue with Google" — the backend only ever
# sees the resulting JWT, which it already knows how to verify.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# AI live MJPEG preview (the AI process publishes annotated webcam frames here)
VITE_AI_PREVIEW_PORT=8001

# AI uploaded-video analysis API
# Leave VITE_AI_API_URL blank to use the current host on port 8002.
VITE_AI_API_URL=
VITE_AI_UPLOAD_API_PORT=8002
